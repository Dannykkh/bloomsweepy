{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BroomSweepy",
  "version": "1.3.0",
  "identifier": "com.broomsweepy.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BroomSweepy 1.3.0",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#090b14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/bloomsweepy-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
