{
  "name": "bloomsweepy-desktop",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "test:file-policy": "node --test --experimental-strip-types tests/fileInspectionPolicy.test.ts",
    "test:cloud-volumes": "node --test --experimental-strip-types tests/cloudVolumePolicy.test.ts",
    "test:volume-path": "node --test --experimental-strip-types tests/volumePath.test.ts",
    "test:docker-intent": "node --test --experimental-strip-types tests/dockerIntent.test.ts",
    "test:docker-format": "node --test --experimental-strip-types tests/dockerFormat.test.ts",
    "test:assistant-text": "node --test --experimental-strip-types tests/assistantText.test.ts",
    "test:i18n": "node --test --experimental-strip-types tests/languagePreference.test.ts tests/localeCatalog.test.ts",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.35.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
